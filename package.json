{
  "name": "@majikah/majik-signature-client-tauri",
  "version": "1.6.0",
  "description": "Typed TypeScript facade over the Tauri signature plugin with bounded native-path single-file and batch streaming APIs.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Majikah/majik-signature-client-tauri.git"
  },
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/jedlsf"
  },
  "homepage": "https://github.com/Majikah/majik-signature-client-tauri#readme",
  "bugs": {
    "url": "https://github.com/Majikah/majik-signature-client-tauri/issues"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build",
    "package": "npm run build && npm version patch && git push && git push --tags",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "peerDependencies": {
    "@majikah/majik-key-client-tauri": "^1.0.0",
    "@tauri-apps/api": ">=2.0.0"
  },
  "devDependencies": {
    "@majikah/majik-key-client-tauri": "^1.0.0",
    "@tauri-apps/api": "^2.12.5",
    "@types/node": "^26.6.11",
    "typescript": "^7.0.2",
    "vitest": "^5.1.2"
  }
}
